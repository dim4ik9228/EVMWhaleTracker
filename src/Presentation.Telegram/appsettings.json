{
  "BlockchainIndexer": {
    "EnableRpcDiagnostics": false,
    "EnableTokenTransferReceiptFetching": false,
    "HttpRpcUrl": "https://mainnet.infura.io/v3/YOUR_PROJECT_ID",
    "WebSocketRpcUrl": "wss://mainnet.infura.io/ws/v3/YOUR_PROJECT_ID",
    "PreferWebSocket": true,
    "StartBlockNumber": null,
    "PollInterval": "00:00:02",
    "WebSocketReconnectDelay": "00:00:05"
  },
  "TelegramBot": {
    "BotToken": "YOUR_BOT_TOKEN"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "ConnectionStrings": {
    "Default": ""
  }
}
