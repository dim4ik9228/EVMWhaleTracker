{
  "BlockchainNetworks": {
    "EnableRpcDiagnostics": false,
    "PreferWebSocket": true,
    "StartBlockNumber": null,
    "PollInterval": "00:00:02",
    "WebSocketReconnectDelay": "00:00:05",
    "Networks": [
      {
        "Chain": "Bsc",
        "Enabled": true,
        "HttpRpcUrl": "https://bsc-mainnet.infura.io/v3/",
        "WebSocketRpcUrl": "wss://bsc-mainnet.infura.io/ws/v3/"
      },
      {
        "Chain": "Base",
        "Enabled": false,
        "HttpRpcUrl": "https://base-mainnet.infura.io/v3/",
        "WebSocketRpcUrl": "wss://base-mainnet.infura.io/ws/v3/"
      },
      {
        "Chain": "Arbitrum",
        "Enabled": false,
        "HttpRpcUrl": "https://arbitrum-mainnet.infura.io/v3/",
        "WebSocketRpcUrl": "wss://arbitrum-mainnet.infura.io/ws/v3/"
      },
      {
        "Chain": "Ethereum",
        "Enabled": false,
        "HttpRpcUrl": "https://mainnet.infura.io/v3/",
        "WebSocketRpcUrl": "wss://mainnet.infura.io/ws/v3/"
      }
    ]
  },
  "AssetPrices": {
    "Enabled": true,
    "CacheDuration": "00:00:30",
    "CoinGeckoSimplePriceUrl": "https://api.coingecko.com/api/v3/simple/price",
    "DexScreenerTokenUrl": "https://api.dexscreener.com/latest/dex/tokens"
  },
  "TelegramBot": {
    "BotToken": "YOUR_BOT_TOKEN"
  },
  "EnsReverseLookup": {
    "Enabled": true,
    "Timeout": "00:00:02",
    "SuccessCacheDuration": "7.00:00:00",
    "MissCacheDuration": "1.00:00:00",
    "FailureCacheDuration": "00:10:00"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext"
    ]
  },
  "ConnectionStrings": {
    "Default": ""
  }
}
